{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Issuer": "id-indetails-api",
    "Audience": "id-indetails-client",
    "SigningKey": "",
    "AccessTokenMinutes": 180
  },
  "RefreshToken": {
    "ExpirationDays": 1,
    "CookieName": "idi_refresh",
    "CookiePath": "/api/auth",
    "SameSite": "Strict"
  },
  "Invitations": {
    "ExpirationDays": 7
  },
  "PasswordReset": {
    "ExpirationMinutes": 30
  },
  "Setup": {
    "SuperAdminKey": ""
  },
  "Company": {
    "TimeZone": "Asia/Beirut"
  },
  "Frontend": {
    "AcceptInvitationPath": "/accept-invitation",
    "LoginPath": "/login",
    "ResetPasswordPath": "/reset-password"
  },
  "Email": {
    "FromName": "ID InDetails",
    "ProductName": "ID InDetails"
  },
  "RateLimiting": {
    "UserPermitsPerMinute": 300,
    "AnonymousPermitsPerMinute": 60,
    "ExportPermitsPerMinute": 10,
    "AuthPermitsPerMinute": 10,
    "SetupPermitsPerHour": 5,
    "UploadPermitsPerMinute": 30
  },
  "FileStorage": {
    "RootPath": "App_Data/files",
    "CleanupEnabled": true
  }
}
