    "ResetPasswordPath": "/reset-password"
  },
  "Email": {
    "FromName": "ID InDetails",
    "ProductName": "ID InDetails"
  },
  "RateLimiting": {
    "UserPermitsPerMinute": 300,
    "AnonymousPermitsPerMinute": 60,
    "ExportPermitsPerMinute": 10,
    "AuthPermitsPerMinute": 10,
    "SetupPermitsPerHour": 5,
