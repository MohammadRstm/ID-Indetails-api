<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ID_Indetails.api</RootNamespace>
    <UserSecretsId>4a6fab00-4657-4867-8ccb-ab9ea741843f</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.53.0" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.103.4" />
    <PackageReference Include="EFCore.NamingConventions" Version="9.0.0" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Google.Apis.AnalyticsData.v1beta" Version="1.77.0.4296" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.20" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.20">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.20" />
    <!-- The driver under Pomelo. Pomelo 9 asks only for 2.4.0 or later, so it is referenced here to get the driver's
         fixes while EF Core stays on 9 (docs/database.md). -->
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <!-- Under MailKit and PDFsharp, which still ask for 10.0.0 or older. Referenced here for the fixes to CVE-2026-84008 and
         CVE-2026-70162 (denial of service, 10.0.0 to 10.0.12). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- the logo at the top of every email, built into the assembly so no deployment has to copy it -->
    <EmbeddedResource Include="Assets\email-logo.png" LogicalName="email-logo.png" />
    <!-- GeoNames' places of 1,000 people or more (CC BY 4.0), trimmed: the website's country and city lists. Only when present, so
         a checkout without it still builds (the lists are then empty). See docs/website.md. -->
    <EmbeddedResource Include="Assets\geonames-cities.tsv.gz" LogicalName="geonames-cities.tsv.gz" Condition="Exists('Assets\geonames-cities.tsv.gz')" />
    <!-- Proton's prompts: Markdown kept apart from the code, read by Proton/Prompts/ProtonPrompts.cs -->
    <EmbeddedResource Include="Proton\Prompts\*.md" LogicalName="ID_Indetails.api.Proton.Prompts.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Jobs\" />
    <Folder Include="HealthChecks\" />
  </ItemGroup>

</Project>
