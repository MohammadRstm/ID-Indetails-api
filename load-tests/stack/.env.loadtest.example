# The load-test environment's settings. On the server it is ~/idi-loadtest/.env, written by
# `./lt.sh init-env` with fresh random secrets and readable by the deploy user only.
#
# It shares nothing with production's /opt/id-indetails/.env. Never copy that file here: lt.sh refuses to run when
# this file holds production's setting names (SMTP_*, MYSQL_*, JWT_SIGNING_KEY, ...). There are no mail settings at
# all: the load-test API always sends to its own Mailpit.

LT_ENVIRONMENT=loadtest
# This environment's id. The tool checks the database server carries the same id before it changes anything.
LT_INSTANCE_ID=
# The server's public IP address (or a name pointing at it). k6 connects to https://<this>:8443.
LT_PUBLIC_HOST=
# k6 sends it as X-LoadTest-Key on every request; anything without it gets 404. 64 hex characters.
LT_GATE_KEY=
LT_DB_ROOT_PASSWORD=
LT_DB_APP_PASSWORD=
LT_JWT_SIGNING_KEY=
# The images under test, as the Deploy workflow published them (sha-<7>).
API_TAG=
CLIENT_TAG=
