# Copy this file to .env (which is gitignored) and replace the placeholder passwords.
# docker compose reads .env automatically from this folder.

# Host port for MySQL. 3306 is MerchForge and 3307 is Handliz, so this project uses 3308.
MYSQL_HOST_PORT=3308

MYSQL_DATABASE=id_indetails
MYSQL_USER=id_indetails_app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Mailpit (local mail catcher). SMTP for the API, and a web inbox for you.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
