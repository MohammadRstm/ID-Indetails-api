# The server's settings for deploy/docker-compose.prod.yml. Copy to .env next to it ON THE SERVER only, fill in, and
# make it readable by the deploy user alone (chmod 600). Never commit the real file: it holds every secret.

# The app's domain, as visitors type it (no https://). Its DNS must point at this server: Caddy gets the
# certificate for it. Emailed links use https://<this>.
PUBLIC_DOMAIN=app.example.com
# Let's Encrypt writes here about certificates that are about to expire.
ACME_EMAIL=admin@example.com

# Database (created on first start). Long random passwords.
MYSQL_DATABASE=id_indetails
MYSQL_USER=id_indetails_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# The running API's own user: read and write rows only, no schema changes (created by each deployment). Letters and
# digits only for its password, e.g. openssl rand -hex 32
MYSQL_API_USER=id_indetails_api
MYSQL_API_PASSWORD=

# At least 32 random characters, e.g. openssl rand -base64 48
JWT_SIGNING_KEY=
# Only to create the first super admin, then empty it again (docs/server-setup.md). At least 32 characters, or the
# API refuses to start.
SETUP_SUPER_ADMIN_KEY=

# Outgoing mail
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
