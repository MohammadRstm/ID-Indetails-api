# The server's settings for deploy/docker-compose.prod.yml. Copy to .env next to it ON THE SERVER only, fill in, and
# make it readable by the deploy user alone (chmod 600). Never commit the real file: it holds every secret.

# Public address of the app, as visitors type it (https, no trailing slash). Used for links in emails.
PUBLIC_URL=https://app.example.com

# Database (created on first start). Long random passwords.
MYSQL_DATABASE=id_indetails
MYSQL_USER=id_indetails_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# At least 32 random characters each, e.g. openssl rand -base64 48
JWT_SIGNING_KEY=
SETUP_SUPER_ADMIN_KEY=

# Outgoing mail
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# Where the client's nginx listens on the server, for the TLS proxy in front (default: loopback only).
# WEB_BIND=127.0.0.1:8080
